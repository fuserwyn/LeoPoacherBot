# Доступы для MCP-сервера трекера (tools/leo-tracker-mcp).
# Скопировать в .env.tracker-mcp и подставить значения из Railway → ms_tracker.
# Файл .env.tracker-mcp гитигнорится.

# Публичный URL сервиса ms_tracker (Railway → ms_tracker → Settings → Domains)
TRACKER_URL=https://ms-tracker-XXXX.up.railway.app
# Секрет доски: переменная TRACKER_SECRET (или BOARD_SSO_SECRET) сервиса ms_tracker
TRACKER_SECRET=

# Куда трекер пишет в карточки — эндпоинт ms_leo (нужен для tracker_report)
LEO_NOTIFY_URL=https://fat-leopard-main.up.railway.app/api/miniapp/board/notify
# Обычно совпадает с TRACKER_SECRET; отдельный NOTIFY_SECRET — если он задан у бота
NOTIFY_SECRET=

BOARD_REPO=fuserwyn/Fat-Leopard
BOARD_BRANCH=main
