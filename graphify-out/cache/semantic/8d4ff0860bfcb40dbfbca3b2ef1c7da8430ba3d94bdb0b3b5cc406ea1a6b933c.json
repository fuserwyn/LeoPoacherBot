{"nodes": [{"id": "readme_strategy", "label": "Fat Leopard Product Strategy & Progression Model", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_fat_leopard", "label": "Fat Leopard (product)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Renamed from Burn & Run; feed-first social community around micro-workouts, RU-only launch."}, {"id": "readme_progression_model", "label": "Progression Model (5 scales + 1)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately splits progress (XP/lifetime) from discipline (fragile streak, protective deletion) so first streak-burn no longer equals app deletion."}, {"id": "readme_xp_formula", "label": "MET-based XP Formula", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "XP = (duration x intensity x type-coeff)/5, min 1; based on MET (WHO/ACSM), the standard behind Apple Health, Google Fit, Strava."}, {"id": "readme_met_standard", "label": "MET Standard (WHO/ACSM)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_levels", "label": "Levels (x2 multiplier, threshold 420)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exponential x2 from 420 XP; calibrated so ~100 XP/week reaches L1 in ~4 weeks. (Strategy version lists 7 tiers up to L7+ 26460.)"}, {"id": "readme_streak", "label": "Streak (\u0428\u043a\